# ============================================================================
# Synthetic Audience Vectors — environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# ----------------------------------------------------------------------------
# Project
# ----------------------------------------------------------------------------
PROJECT_NAME=isc_mod
ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
RANDOM_SEED=42

# ----------------------------------------------------------------------------
# Paths (local disk layout — change ROOT to move the whole data lake)
# ----------------------------------------------------------------------------
DATA_ROOT=./data
RAW_DIR=${DATA_ROOT}/raw
PROCESSED_DIR=${DATA_ROOT}/processed
CLIPS_DIR=${DATA_ROOT}/processed/clips_3s
FRAMES_DIR=${DATA_ROOT}/processed/frames
AUDIO_DIR=${DATA_ROOT}/processed/audio
TRANSCRIPTS_DIR=${DATA_ROOT}/processed/transcripts
FEATURES_DIR=${DATA_ROOT}/features
LABELS_DIR=${DATA_ROOT}/labels
TRAINING_DIR=${DATA_ROOT}/training
MODELS_DIR=${DATA_ROOT}/models
VECTORS_DIR=${DATA_ROOT}/models/vectors
REPORTS_DIR=${DATA_ROOT}/reports

# ----------------------------------------------------------------------------
# Manifest DB (SQLite — single file, easy to migrate to Postgres later)
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/manifest.db
# Future Postgres / Supabase:
# DATABASE_URL=postgresql://user:pass@host:5432/audience_vectors
# SUPABASE_URL=
# SUPABASE_KEY=

# ----------------------------------------------------------------------------
# Anthropic — persona generation, LLM judges, transcript labelers
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Default models. Sonnet for judging / structured outputs, Haiku for cheap bulk labeling.
ANTHROPIC_MODEL_JUDGE=claude-sonnet-4-6
ANTHROPIC_MODEL_BULK=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# OpenAI — optional (GPT-4o judge / frame-level evaluation)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_JUDGE=gpt-4o
OPENAI_MODEL_BULK=gpt-4o-mini

# ----------------------------------------------------------------------------
# Google Gemini — primary VLM for zero-shot video labeling
# ----------------------------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL_VIDEO=gemini-2.5-flash       # cheap/fast video understanding
GEMINI_MODEL_JUDGE=gemini-2.5-pro         # higher-quality fallback for hard cases
GEMINI_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# HuggingFace — downloading TRIBE, InternVideo2, V-JEPA 2, Qwen2.5-VL, Whisper
# ----------------------------------------------------------------------------
# Project-specific read token for Llama gated-model access. Modal aliases this
# into the standard Hugging Face token env names below.
LLAMA_READ_TOKEN=
HUGGINGFACE_TOKEN=
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=
HF_HOME=${DATA_ROOT}/.cache/huggingface
TRANSFORMERS_CACHE=${HF_HOME}/hub
TORCH_HOME=${DATA_ROOT}/.cache/torch

# Model IDs (pinned to revisions known to work — see README.md model table).
# TRIBE v2 is CC-BY-NC-4.0; the whole pipeline inherits non-commercial.
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_MODEL_REVISION=f894e783020944dcd96e5568550afe2aa9743f9f
TRIBE_GIT_REF=72399081ed3f1040c4d996cefb2864a4c46f5b8e   # facebookresearch/tribev2 commit

# V-JEPA 2: ViT-L is the lighter default; ViT-g is what TRIBE uses internally.
VJEPA_MODEL_ID=facebook/vjepa2-vitl-fpc64-256
VJEPA_LARGE_MODEL_ID=facebook/vjepa2-vitg-fpc64-256

# InternVideo2 encoder is gated (must accept terms on HF first).
INTERNVIDEO_MODEL_ID=OpenGVLab/InternVideo2-Stage2_1B-224p-f4
# Optional chat-capable alternative (8B, released Jan 2025):
# INTERNVIDEO_CHAT_MODEL_ID=OpenGVLab/InternVideo2_5_Chat_8B

# Qwen3-VL is the current default (released late 2025). Drop to 2.5 if you
# need parity with prior results.
QWEN_VL_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
# QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

WHISPER_MODEL_ID=openai/whisper-large-v3
FASTER_WHISPER_MODEL_ID=Systran/faster-whisper-large-v3

# ----------------------------------------------------------------------------
# Experiment tracking
# ----------------------------------------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=audience-vectors
WANDB_ENTITY=
WANDB_MODE=online            # online | offline | disabled

# ----------------------------------------------------------------------------
# Modal (only needed when you push GPU jobs off-laptop)
# Modal auth is normally done via `modal token set` — these are optional.
# ----------------------------------------------------------------------------
MODAL_WORKSPACE=
MODAL_DEFAULT_GPU=L40S       # T4 | A10G | L40S | A100 | H100

# ----------------------------------------------------------------------------
# Pipeline config (segment-level processing)
# ----------------------------------------------------------------------------
SEGMENT_LENGTH_SECONDS=3.0
SEGMENT_STRIDE_SECONDS=3.0   # set to 1.5 for overlapping windows in v2
SAMPLE_FPS=2                 # frames extracted per second for VLM judging
AUDIO_SAMPLE_RATE=16000
DEV_VIDEO_LIMIT=20           # cap for the MVP first-week run

# ----------------------------------------------------------------------------
# Dataset locations (fill in once you've downloaded each)
# Adapters read from these roots; leave blank to skip that dataset.
# ----------------------------------------------------------------------------
VIDEOMEM_ROOT=
MEMENTO10K_ROOT=
VIDEM_ROOT=
MEDIAEVAL_ROOT=
BOLD_MOMENTS_ROOT=
HASSON_ROOT=
PEEK_ROOT=

# ----------------------------------------------------------------------------
# Future: object storage (uncomment when migrating off local disk)
# ----------------------------------------------------------------------------
# STORAGE_BACKEND=local       # local | s3 | r2 | gcs
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=
